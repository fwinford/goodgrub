{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status --short)",
      "Bash(git diff --stat)",
      "Bash(git diff --check)",
      "Bash(git log -3 --oneline)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:mongo)",
      "Bash(npm run ci-check)",
      "Bash(npm run build:client)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
  }
}
