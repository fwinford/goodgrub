# Install alongside the production template; production owns default servers.
map $http_upgrade $review_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${REVIEW_HOSTNAME};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / {
        return 301 https://${REVIEW_HOSTNAME}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${REVIEW_HOSTNAME};
    ssl_certificate /etc/letsencrypt/live/${REVIEW_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${REVIEW_HOSTNAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log off;
    client_max_body_size 35m;
    client_body_timeout 60s;
    send_timeout 60s;

    if (-f /var/lib/commonplate-review/quarantine) {
        return 503;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host ${REVIEW_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $review_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }
}
