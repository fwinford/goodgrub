# Install as a commonplate.service drop-in only after the corresponding
# encrypted credential files exist and activation is separately authorized.
# Uncomment only credentials required by the approved production configuration.
[Service]
# LoadCredentialEncrypted=PARTICIPATION_HMAC_KEYRING:/etc/credstore.encrypted/commonplate-production/PARTICIPATION_HMAC_KEYRING
# LoadCredentialEncrypted=BLOCK_SAFETY_HMAC_KEYRING:/etc/credstore.encrypted/commonplate-production/BLOCK_SAFETY_HMAC_KEYRING
